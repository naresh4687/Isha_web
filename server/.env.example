# --- Required ---
NODE_ENV=development                 # development | test | production
DATABASE_URL=postgres://anvaya:<password>@localhost:5433/anvaya
JWT_SECRET=<random string, at least 32 characters>

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173    # only needed if the web app is served from another origin
COOKIE_SECURE=false                  # forced true when NODE_ENV=production
BRAND_NAME=Anvaya                    # seeded into settings.brand on first seed

# --- Payments ---
# razorpay: real provider (use rzp_test_ keys for test mode)
# mock:     development simulator; refused at startup when NODE_ENV=production
# none:     checkout reports "payments not configured"
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=<rzp_test_...>
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<webhook secret>

# --- ML service (internal) ---
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=<shared random token, same value as ml/.env>

# --- Data retention & business rules ---
EVENT_RETENTION_DAYS=395
LOW_STOCK_THRESHOLD=5
FREE_SHIPPING_THRESHOLD_PAISE=99900
SHIPPING_FEE_PAISE=7900
SELLER_STATE=<e.g. Karnataka>          # optional; enables the CGST+SGST vs IGST split in tax breakdowns

# --- Seeding (optional) ---
ADMIN_EMAIL=admin@anvaya.local
ADMIN_PASSWORD=<required in production; dev default is printed by the seed script>
