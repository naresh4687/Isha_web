{
  "name": "anvaya-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx seed/seed.ts",
    "seed:demo": "tsx seed/demo.ts",
    "purge-events": "tsx src/scripts/purgeEvents.ts",
    "typecheck": "tsc --noEmit",
